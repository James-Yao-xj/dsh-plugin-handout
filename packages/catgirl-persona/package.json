{
  "name": "dsh-persona-catgirl",
  "version": "0.1.0",
  "description": "小猫之神 OpenCode 人格：让 DSH 用轻松治愈的猫娘语气说话，写文档时切回轻快正式",
  "type": "module",
  "license": "MIT",
  "author": "James-Yao-xj",
  "icon": "./icon.svg",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/James-Yao-xj/dsh-plugin-handout.git",
    "directory": "packages/catgirl-persona"
  },
  "homepage": "https://github.com/James-Yao-xj/dsh-plugin-handout/tree/main/packages/catgirl-persona#readme",
  "bugs": {
    "url": "https://github.com/James-Yao-xj/dsh-plugin-handout/issues"
  },
  "keywords": ["dsh", "deepseek-harness", "cordis", "plugin", "persona", "catgirl"],
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "prompts",
    "locale",
    "docs",
    "icon.svg",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.4"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4"
  },
  "scripts": {
    "test": "node --test test/*.test.js"
  }
